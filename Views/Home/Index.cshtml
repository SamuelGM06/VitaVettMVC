@using System.Security.Claims
@{
    ViewData["Title"] = "Inicio";
    var nombre = User.FindFirstValue(ClaimTypes.Name);
    var rol = User.FindFirstValue(ClaimTypes.Role);
}

<section class="vv-card p-4 p-md-5 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1 class="display-6 mb-2">Bienvenido, @nombre</h1>
            <p class="text-muted mb-3">Expediente electrónico veterinario de VitaVett.</p>
            <span class="vv-pill vv-pill-outline">@rol</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (rol == "Administrador")
            {
                <a class="btn btn-primary" asp-controller="Usuarios" asp-action="Index">Gestionar usuarios</a>
                <a class="btn btn-outline-primary" asp-controller="Veterinarios" asp-action="Index">Veterinarios</a>
            }
            @if (rol == "Administrador" || rol == "Veterinario")
            {
                <a class="btn btn-accent" asp-controller="Mascotas" asp-action="Index">Ver mascotas</a>
            }
        </div>
    </div>
</section>

@if (rol == "Dueno")
{
    <section class="vv-card vv-seccion">
        <h2>El expediente de sus mascotas</h2>
        <p class="mb-0">Las vacunas, tratamientos, exámenes y notas que registre su veterinario se consultan desde la aplicación móvil de VitaVett.</p>
    </section>
}

@if (rol == "Administrador" || rol == "Veterinario")
{
    var vencidas = (List<AplicacionVacuna>)ViewBag.Vencidas;
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="vv-card vv-indicador"><strong>@ViewBag.TotalMascotas</strong><span>Pacientes registrados</span></div>
        </div>
        <div class="col-sm-4">
            <div class="vv-card vv-indicador @(ViewBag.TotalVencidas > 0 ? "vv-alerta" : "")"><strong>@ViewBag.TotalVencidas</strong><span>Vacunas vencidas</span></div>
        </div>
        <div class="col-sm-4">
            <div class="vv-card vv-indicador"><strong>@ViewBag.TotalTratamientos</strong><span>Tratamientos vigentes</span></div>
        </div>
    </div>

    <section class="vv-card vv-seccion">
        <h2>Vacunas por renovar</h2>
        @if (vencidas.Any())
        {
            <ul class="list-unstyled mb-0">
                @foreach (var v in vencidas)
                {
                    <li class="d-flex justify-content-between align-items-center gap-2 py-2 border-bottom">
                        <span>
                            <a class="fw-semibold" asp-controller="Expediente" asp-action="Index" asp-route-id="@v.MascotaId">@v.Mascota.Nombre</a>
                            <span class="text-muted">· @v.ItemClinico.Nombre</span>
                        </span>
                        <span class="vv-vencida">Vencida el @v.ProximaDosis?.ToString("dd/MM/yyyy")</span>
                    </li>
                }
            </ul>
            @if (ViewBag.TotalVencidas > vencidas.Count)
            {
                <p class="small text-muted mt-2 mb-0">Se muestran las @vencidas.Count más antiguas de @ViewBag.TotalVencidas.</p>
            }
        }
        else
        {
            <p class="vv-vacio mb-0">Todas las vacunas están al día.</p>
        }
    </section>
}

@if (rol == "Administrador")
{
    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <a class="text-decoration-none" asp-controller="Especies" asp-action="Index">
                <div class="vv-card p-3 h-100">
                    <h5 class="mb-1">Especies</h5>
                    <p class="text-muted small mb-0">Catálogo de especies y razas.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="text-decoration-none" asp-controller="CatalogoClinico" asp-action="Index">
                <div class="vv-card p-3 h-100">
                    <h5 class="mb-1">Catálogo clínico</h5>
                    <p class="text-muted small mb-0">Medicamentos, tratamientos y vacunas.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="text-decoration-none" asp-controller="Veterinarios" asp-action="Index">
                <div class="vv-card p-3 h-100">
                    <h5 class="mb-1">Veterinarios</h5>
                    <p class="text-muted small mb-0">Perfiles, colegiados y fotografías.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="text-decoration-none" asp-controller="Usuarios" asp-action="Index">
                <div class="vv-card p-3 h-100">
                    <h5 class="mb-1">Usuarios</h5>
                    <p class="text-muted small mb-0">Administradores y dueños.</p>
                </div>
            </a>
        </div>
    </div>
}
