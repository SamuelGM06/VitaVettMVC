@model List<VitaVettMVC.Models.Especie>
@{
    ViewData["Title"] = "Especies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Especies</h2>
    <a class="btn btn-primary" asp-action="Create">Nueva especie</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var especie in Model)
        {
            <tr>
                <td>@especie.Nombre</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@especie.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@especie.Id">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="2" class="text-muted">No hay especies registradas.</td></tr>
        }
    </tbody>
</table>
