@using VitaVettMVC.Models
@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    RolUsuario? seleccionado = ViewBag.RolSeleccionado;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Usuarios</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo usuario</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="rol" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los roles</option>
            @foreach (var rol in Enum.GetValues<RolUsuario>())
            {
                <option value="@rol" selected="@(seleccionado == rol)">@rol</option>
            }
        </select>
    </div>
</form>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Nombre @u.Apellidos</td>
                <td>@u.Cedula</td>
                <td>@u.Email</td>
                <td>@u.Rol</td>
                <td>
                    @if (u.Bloqueado)
                    {
                        <span class="badge bg-secondary">Bloqueado</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                </td>
                <td class="text-end">
                    @if (u.Rol == RolUsuario.Veterinario)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Veterinarios" asp-action="Index">Gestionar en Veterinarios</a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="CambiarPassword" asp-route-id="@u.Id">Contraseña</a>
                        <form asp-action="CambiarBloqueo" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(u.Bloqueado ? "Desbloquear" : "Bloquear")
                            </button>
                        </form>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id">Eliminar</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-muted">No hay usuarios.</td></tr>
        }
    </tbody>
</table>
