@using VitaVettMVC.Models.ViewModels
@model VeterinarioFormViewModel
@{
    ViewData["Title"] = "Editar veterinario";
    ViewBag.EsCreacion = false;
}

<h2 class="mb-3">Editar veterinario</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="ms-2" asp-action="Index">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
