@model List<VitaVettMVC.Models.Veterinario>
@{
    ViewData["Title"] = "Veterinarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Veterinarios</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo veterinario</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Colegiado</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vet in Model)
        {
            <tr>
                <td>
                    @if (vet.Foto is not null)
                    {
                        <img src="@Url.Action("Foto", new { id = vet.Id })" alt="Foto" width="48" height="48" class="rounded-circle" style="object-fit:cover" />
                    }
                </td>
                <td>@vet.Usuario.Nombre @vet.Usuario.Apellidos</td>
                <td>@vet.Usuario.Cedula</td>
                <td>@vet.NumeroColegiado</td>
                <td>
                    @if (vet.Usuario.Bloqueado)
                    {
                        <span class="badge bg-secondary">Bloqueado</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@vet.Id">Editar</a>
                    <form asp-action="CambiarBloqueo" asp-route-id="@vet.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-warning">
                            @(vet.Usuario.Bloqueado ? "Desbloquear" : "Bloquear")
                        </button>
                    </form>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@vet.Id">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-muted">No hay veterinarios registrados.</td></tr>
        }
    </tbody>
</table>
