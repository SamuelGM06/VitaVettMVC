@model List<VitaVettMVC.Models.Mascota>
@{
    ViewData["Title"] = "Mascotas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Mascotas</h2>
        <p class="vv-eyebrow mb-0">@Model.Count @(Model.Count == 1 ? "paciente" : "pacientes")@(string.IsNullOrWhiteSpace(ViewBag.Buscar as string) ? "" : " encontrados")</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva mascota</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="d-flex gap-2 mb-3">
    <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por mascota, dueño o cédula" />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
</form>

<div class="table-responsive">
<table class="table table-striped align-middle mb-0">
    <thead>
        <tr>
            <th>Paciente</th>
            <th>Especie / raza</th>
            <th>Dueño</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-3">
                        @if (m.Foto is not null)
                        {
                            <img src="@Url.Action("Foto", new { id = m.Id })" alt="" class="vv-avatar" />
                        }
                        else
                        {
                            <span class="vv-avatar" aria-hidden="true">@m.Especie.Nombre[..1]</span>
                        }
                        <div>
                            <a class="fw-semibold" asp-controller="Expediente" asp-action="Index" asp-route-id="@m.Id">@m.Nombre</a>
                            <div class="small text-muted">@string.Join(" · ", new[] { m.Sexo, m.Edad }.Where(s => s is not null))</div>
                        </div>
                    </div>
                </td>
                <td>@m.Especie.Nombre @(m.Raza is null ? "" : $"/ {m.Raza.Nombre}")</td>
                <td>@m.Dueno.Nombre @m.Dueno.Apellidos <span class="text-muted small">(@m.Dueno.Cedula)</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-primary" asp-controller="Expediente" asp-action="Index" asp-route-id="@m.Id">Expediente</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@m.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.Id">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="vv-vacio">@(string.IsNullOrWhiteSpace(ViewBag.Buscar as string) ? "Todavía no hay pacientes. Registre la primera mascota con el botón Nueva mascota." : "Ninguna mascota coincide con la búsqueda.")</td></tr>
        }
    </tbody>
</table>
</div>
