@model List<VitaVettMVC.Models.Mascota>
@{
    ViewData["Title"] = "Mascotas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mascotas</h2>
    <a class="btn btn-primary" asp-action="Create">Nueva mascota</a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="d-flex gap-2 mb-3">
    <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por mascota, dueño o cédula" />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Especie / raza</th>
            <th>Dueño</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>
                    @if (m.Foto is not null)
                    {
                        <img src="@Url.Action("Foto", new { id = m.Id })" alt="Foto" width="48" height="48" class="rounded-circle" style="object-fit:cover" />
                    }
                </td>
                <td>@m.Nombre</td>
                <td>@m.Especie.Nombre @(m.Raza is null ? "" : $"/ {m.Raza.Nombre}")</td>
                <td>@m.Dueno.Nombre @m.Dueno.Apellidos <span class="text-muted small">(@m.Dueno.Cedula)</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@m.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.Id">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-muted">No hay mascotas registradas.</td></tr>
        }
    </tbody>
</table>
