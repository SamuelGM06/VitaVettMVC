@model VitaVettMVC.Models.Mascota
@{
    ViewData["Title"] = "Eliminar mascota";
    var enUso = ViewBag.EnUso == true;
}

<h2 class="mb-3">Eliminar mascota</h2>

<p>¿Desea eliminar a <strong>@Model.Nombre</strong> (@Model.Especie.Nombre), de @Model.Dueno.Nombre @Model.Dueno.Apellidos?</p>

@if (enUso)
{
    <div class="alert alert-warning">
        No se puede eliminar: la mascota ya tiene registros en su expediente clínico.
    </div>
    <a asp-action="Index">Volver</a>
}
else
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="ms-2" asp-action="Index">Cancelar</a>
    </form>
}
