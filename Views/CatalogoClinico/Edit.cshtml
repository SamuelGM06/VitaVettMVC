@using VitaVettMVC.Models.ViewModels
@model ItemClinicoFormViewModel
@{
    ViewData["Title"] = "Editar ítem clínico";
}

<h2 class="mb-3">Editar ítem del catálogo clínico</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="ms-2" asp-action="Index">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
