@using VitaVettMVC.Models
@model List<ItemClinico>
@{
    ViewData["Title"] = "Catálogo clínico";
    TipoItemClinico? seleccionado = ViewBag.TipoSeleccionado;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo clínico</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo ítem</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="tipo" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los tipos</option>
            @foreach (var tipo in Enum.GetValues<TipoItemClinico>())
            {
                <option value="@tipo" selected="@(seleccionado == tipo)">@tipo</option>
            }
        </select>
    </div>
</form>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Nombre</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Tipo</td>
                <td>@item.Nombre</td>
                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <form asp-action="CambiarActivo" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-warning">
                            @(item.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-muted">No hay ítems en el catálogo.</td></tr>
        }
    </tbody>
</table>
